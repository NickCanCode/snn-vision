# Copy to .env and fill in. server.py reads it; the browser never sees it.
ROBOFLOW_API_KEY=your_key_here
# Optional: use a self-hosted Roboflow Inference server instead of the cloud
# ROBOFLOW_API_URL=http://localhost:9001
# Optional: which board model Board mode uses (project/version). This is the default:
# ROBOFLOW_BOARD_MODEL=yerrrrrrrrrr/1
# Optional: run the board model on this Mac (needs snn-camera/.venv with Roboflow's package, see server.py)
# ROBOFLOW_LOCAL=1
